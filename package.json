{
  "name": "zodline",
  "version": "0.3.1",
  "description": "Type-safe CLI argument parser powered by Zod schemas. Zero dependencies, inferred TypeScript types, and automatic help generation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "homepage": "https://zodline.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capawesome-team/zodline.git"
  },
  "bugs": {
    "url": "https://github.com/capawesome-team/zodline/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "fmt": "prettier --write \"src/**/*.{ts,js,json}\"",
    "lint": "prettier --check \"src/**/*.{ts,js,json}\"",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "blume dev",
    "docs:build": "blume build && rm -rf .blume-dist && cp -R dist .blume-dist",
    "docs:preview": "blume preview",
    "docs:check": "blume check",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "astro": "^7.1.6",
    "blume": "^1.3.1",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "cli",
    "parser",
    "cli-parser",
    "command-line",
    "command-line-parser",
    "argv",
    "arguments",
    "args",
    "flags",
    "options",
    "zod",
    "zod-cli",
    "typescript",
    "type-safe",
    "validation",
    "esm",
    "commander-alternative",
    "yargs-alternative"
  ],
  "author": "Robin Genz <mail@robingenz.dev>",
  "license": "MIT"
}
